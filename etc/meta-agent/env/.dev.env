ENV=development

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=meta-agent
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps

# kafka
KAFKA_GROUP_ID=meta-agent

# Auth
AUTH_VERIFY_SSL=false

ASB_SUBSCRIPTION_NAME=meta-agent

# Telemetry
INSTRUMENTATION_ENABLED=false
SERVICE_NAME=meta-agent
EXPORTER_TYPE=azure

# otlp example
OTLP_LOG_ENDPOINT=http://otlp:4317
OTLP_TRACE_ENDPOINT=http://otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=connection_string

# Agentic AI Service integration
AGENTIC_AI_URL=http://deps-agentic-ai:8000
META_AGENT_URL=http://deps-meta-agent:8000/api/meta-agent/v1/chat

# ============================================
# Orchestrator Settings
# ============================================

# Provider to use for orchestrator LLM (EPAM_DIAL, AZURE, OPENAI, GOOGLE, AWS_BEDROCK)
ORCHESTRATOR_PROVIDER_ID=EPAM_DIAL

# Model ID/name for the orchestrator LLM
ORCHESTRATOR_MODEL_ID=gpt-4o

# Maximum number of agents to try in chain before giving up (default: 3)
ORCHESTRATOR_MAX_ITERATIONS=3

EPAM_DIAL_ENDPOINT=https://your-dial-endpoint.com
EPAM_DIAL_API_KEY=your-api-key
EPAM_DIAL_API_VERSION=2024-02-01

AZURE_API_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_KEY=your-azure-key
AZURE_API_VERSION=2024-02-01

OPENAI_API_KEY=sk-your-openai-key

GOOGLE_API_KEY=your-google-api-key

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
